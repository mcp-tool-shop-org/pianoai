{
  "name": "@mcptoolshop/ai-jam-sessions",
  "version": "2.4.0",
  "description": "Teach your AI to play piano and guitar, sing, and now LISTEN. 53 MCP tools, 120 songs, 6 engines, a browser cockpit, and an audio inspector that measures a recording: onsets, pitch in cents, transcription, and grading a performance by ear. Ships two public tool-use datasets over symbolic and acoustic music.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-jam-sessions": "dist/cli.js",
    "ai-jam-sessions-mcp": "dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs/spectrogram-surface-study-2026-09.md",
    "docs/vocal-singing-study-2026-09.md",
    "docs/fur-elise-m1-8.svg",
    "samples/vocal",
    "songs/library",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "logo.png",
    "logo-banner.png"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp-server.js",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "smoke": "node --import tsx src/smoke.ts",
    "setup": "tsx scripts/generate-carriers.ts"
  },
  "keywords": [
    "piano",
    "audio",
    "midi",
    "mcp",
    "ai",
    "music",
    "voice",
    "web-audio"
  ],
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-tool-shop-org/ai-jam-sessions.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "^8.20.0",
    "jzz": "^1.8.0",
    "midi-file": "^1.2.4",
    "node-web-audio-api": "^2.0.0",
    "pink-trombone-mod": "^0.1.0",
    "vocal-synth-engine": "github:mcp-tool-shop-org/vocal-synth-engine#7269cd539b20907743601f66812b3d904d43508e",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
